{
  "name": "conceal-authenticator",
  "version": "1.1.4",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "export REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.19 && expo start",
    "build": "expo export",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "types": "tsc --noEmit",
    "preflight": "npm run types && npm run lint && npm run format && npm run check",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:integration": "jest --forceExit",
    "ci:act": "scripts/act-ci.sh ci",
    "ci:act:security": "scripts/act-ci.sh security",
    "ci:act:all": "scripts/act-ci.sh all"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@g9k/expo-dynamic-app-icon": "^2.0.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^54.0.4",
    "dotenv": "^17.2.3",
    "expo": "^54.0.20",
    "expo-build-properties": "^1.0.9",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "^18.0.9",
    "expo-crypto": "~15.0.7",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.8",
    "expo-local-authentication": "~17.0.7",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "nativewind": "^4.2.1",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-conceal-crypto": "https://github.com/concealnetwork/react-native-conceal-crypto/releases/download/v0.2.9/react-native-conceal-crypto-0.2.9.tgz",
    "react-native-css-interop": "^0.2.1",
    "react-native-dynamic-app-icon": "^1.1.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-nitro-modules": "^0.30.2",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vision-camera": "^4.7.3",
    "react-native-worklets": "^0.6.1",
    "react-native-worklets-core": "^1.6.2",
    "tailwindcss": "^3.4.18",
    "vision-camera-zxing": "^0.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@biomejs/biome": "2.5.6",
    "@react-native-community/cli": "^20.0.1",
    "@react-native/metro-config": "^0.81.4",
    "@types/node": "^24.9.1",
    "@types/react": "~19.1.10",
    "expo-dev-client": "~6.0.13",
    "metro": "^0.83.1",
    "metro-babel-transformer": "^0.83.1",
    "metro-core": "^0.83.1",
    "metro-runtime": "^0.83.1",
    "metro-source-map": "^0.83.1",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.12",
    "react-test-renderer": "19.1.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          ".*"
        ]
      }
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@g9k/expo-dynamic-app-icon",
          "react-native-dynamic-app-icon"
        ]
      }
    }
  },
  "overrides": {
    "node-forge": "1.4.0",
    "nanoid": "3.3.18",
    "uuid": "11.1.1",
    "postcss": "8.5.25",
    "@g9k/expo-dynamic-app-icon": {
      "expo-modules-core": "^3.0.25"
    },
    "js-yaml": "^4.1.1",
    "glob": "^11.1.0",
    "fast-xml-parser": "^5.3.7",
    "minimatch": "^10.2.3"
  },
  "postinstall": "patch-package",
  "private": true
}
